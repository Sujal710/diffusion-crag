GROQ_API_KEY=gsk_your_key
# optional overrides (check console.groq.com/docs/models for current IDs)
# GROQ_GENERATOR_MODEL=openai/gpt-oss-120b
# GROQ_GRADER_MODEL=openai/gpt-oss-20b

PINECONE_API_KEY=pcsk_your_key
PINECONE_INDEX=crag-docs
PINECONE_NAMESPACE=default
# free Starter plan only supports aws / us-east-1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

TAVILY_API_KEY=tvly-your_key

MAX_ATTEMPTS=3
UPPER_THRESHOLD=0.7
LOWER_THRESHOLD=0.3

# Text -> video (Hugging Face Inference API, open-source Stable Diffusion)
# Token: huggingface.co/settings/tokens (enable "Make calls to Inference Providers")
HF_TOKEN=hf_your_token
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# HF_PROVIDER=auto

# Which image API makes the video frames: cloudflare (free daily allowance) or huggingface
IMAGE_PROVIDER=cloudflare
# Cloudflare Workers AI: dash.cloudflare.com -> Workers AI -> Use REST API
CF_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_workers_ai_token
# CF_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
